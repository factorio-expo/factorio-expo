{
	"$schema": "./node_modules/oxfmt/configuration_schema.json",
	"printWidth": 100,
	"semi": true,
	"singleQuote": false,
	"useTabs": true,
	"tabWidth": 4,
	"svelte": true,
	"astro": true,
	"ignorePatterns": [
		"**/node_modules/**",
		"**/dist/**",
		"**/.astro/**",
		"**/*.yaml",
		"**/*.md",
		"packages/expo-ui/src/game/data/**",
		"packages/expo-api-types/src/public.d.ts",
		"packages/expo-api-types/src/admin.d.ts",
		"apps/expo-web/src/generated/**",
		"e2e/playwright-report/**",
		"e2e/test-results/**",
		"apps/expo-api/**",
		"apps/expo-render-worker/**",
		"apps/expo-db/**",
		"apps/expo-game-data/**",
		"internal/**",
		"factorio/**",
		"data/**",
		"docs/**",
		"scripts/**",
		"test-data/**",
		".bin/**",
		".claude/**",
		".idea/**",
		".github/**"
	]
}
