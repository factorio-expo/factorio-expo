# Copy to .env and replace the dummy values. Read by docker-compose.yaml.
#
# Uncommented lines are required: `docker compose` fails when they are missing.
# Commented lines show the default used when the variable is unset.


# =============================================================================
# Factorio account
# =============================================================================

# Used by factorio-downloader to fetch the game (required).
FACTORIO_USERNAME=your-factorio-username

# Token from https://factorio.com/profile, not your password (required).
FACTORIO_TOKEN=dummy-factorio-token

# Pinned game version to download.
# FACTORIO_VERSION=2.1.24


# =============================================================================
# Factorio server / client
# =============================================================================

# RCON password, shared by factorio-server and expo-render-worker (required).
FACTORIO_RCON_PASSWORD=change-me-rcon-password

# FACTORIO_RCON_PORT=27015

# FACTORIO_GAME_PORT=34197

# Software GL driver for the headless graphical client.
# GALLIUM_DRIVER=llvmpipe

# Headless client frame rate.
# FACTORIO_CLIENT_FPS=10

# Headless client rasteriser thread count.
# FACTORIO_CLIENT_RASTER_THREADS=2


# =============================================================================
# PostgreSQL
# =============================================================================

# Superuser, used only by expo-db-setup / expo-db-migrate.
# POSTGRES_USER=factorio_expo

# Superuser password (required).
POSTGRES_PASSWORD=change-me-postgres-password

# Catalog database name.
# POSTGRES_DB=factorio_expo


# expo-api: row-access-only role on the catalog database.
# API_POSTGRES_USER=factorio_expo_api

# Password for the expo-api role (required).
API_POSTGRES_PASSWORD=change-me-api-postgres-password


# expo-render-worker: row-access-only role and its own database.
# RUNNER_POSTGRES_USER=factorio_expo_runner

# Password for the expo-render-worker role (required).
RUNNER_POSTGRES_PASSWORD=change-me-runner-postgres-password

# RUNNER_POSTGRES_DB=factorio_expo_runner


# =============================================================================
# Typesense (search)
# =============================================================================

# Default is a local-dev key; the API refuses it unless the site is localhost.
# Production: openssl rand -base64 32
# TYPESENSE_API_KEY=local-dev-typesense-key


# =============================================================================
# API
# =============================================================================

# Secret used to sign session JWTs and the sign-in flow cookies (required). At least 32 bytes, e.g.
# `openssl rand -base64 48`. The API refuses to start with a shorter one or
# with these change-me placeholders.
API_JWT_SECRET=change-me-to-a-long-random-string-of-at-least-32-bytes

# Only while rotating API_JWT_SECRET: the retired secret, which still verifies
# sessions and sign-in cookies but never signs. Remove it after 7 days.
# Leave unset otherwise.
# API_JWT_SECRET_PREVIOUS=

# Secret keying the HMAC that IP bans store instead of addresses (required, at
# least 32 bytes, different from API_JWT_SECRET; placeholders are refused too).
# Rotating it lifts active IP bans.
API_IP_HASH_SECRET=change-me-to-another-long-random-string-of-32-bytes

# How long a banned account's IP stays banned (default 6h, at most 24h).
# API_IP_BAN_DURATION=6h

# Score a tag needs before the upload form suggests it (default 2).
# API_TAG_SUGGESTION_MIN_SCORE=2

# Sign-in providers. Accounts have no
# password: they sign in with a passkey (no setup) or one of these, each on
# when its credentials are set. Register each app's callback as
# {PUBLIC_API_BASE_URL}/api/v1/auth/{github,discord,steam,google}/callback.
# API_GITHUB_CLIENT_ID=
# API_GITHUB_CLIENT_SECRET=
# API_DISCORD_CLIENT_ID=
# API_DISCORD_CLIENT_SECRET=
# Steam needs only a Web API key (https://steamcommunity.com/dev/apikey).
# API_STEAM_API_KEY=
# API_GOOGLE_CLIENT_ID=
# API_GOOGLE_CLIENT_SECRET=

# Cloudflare Turnstile on the sign-up forms and on anonymous uploads, quick
# previews, revisions and reports: the widget's
# secret key. Set it together with PUBLIC_TURNSTILE_SITE_KEY below; with only
# this one set, every such request is refused. Both unset: off.
# On localhost, Cloudflare's test keys always pass (never use them in
# production): API_TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
# with PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA.
# API_TURNSTILE_SECRET_KEY=

# Purge the CDN's cached preview images when an entry goes private, is deleted
# or expires: an API token with the
# "Cache Purge" permission on the zone, and the zone id. Either one unset:
# nothing is purged (the images' 1-day max-age applies).
# API_CLOUDFLARE_API_TOKEN=
# API_CLOUDFLARE_ZONE_ID=

# Render queue (docs/architecture.md#render-queue). Defaults shown; tune them
# after the capacity test.
# Fetches an hour the API makes from each import-from-link site over all
# callers (spent: 503 import_site_busy), and from GitHub gists.
# API_IMPORT_HOURLY_BUDGET=300
# API_IMPORT_GIST_HOURLY_BUDGET=40

# API_RENDER_WINDOW=2                # runner jobs unfinished at once
# API_RENDER_CAP_ANONYMOUS=100       # waiting leaves per anonymous address
# API_RENDER_CAP_SIGNED_IN=300       # waiting leaves per account
# API_RENDER_DELAY_SIGNED_IN=30s     # quick previews and staff re-runs: 0
# API_RENDER_DELAY_ANONYMOUS=2m
# API_RENDER_DELAY_RERENDER=1m       # added to the requester's own delay
# API_RENDER_DELAY_REPAIR=2m
# API_RENDER_LEAF_GAP=30s            # spacing of one uploader's waiting leaves


# =============================================================================
# Public origin (production)
# =============================================================================
# Same origin for site and API: the reverse proxy routes /api/v1/* to expo-api,
# everything else to expo-web.

# Browser-facing API origin, baked into the web image at build time.
# PUBLIC_API_BASE_URL=http://localhost:8080

# Comma-separated list of origins allowed by CORS. The first is the site's own
# origin: passkeys work only there and sign-ins redirect to it. Put
# http://localhost:4321 first when you browse the site through astro dev.
# API_ALLOWED_ORIGIN=http://localhost:3000,http://localhost:4321

# Rate limiting stays on by default; set false for local development.
# API_RATE_LIMIT=true

# Session cookie is Secure + __Host- by default. Set false only if a local
# plain-HTTP setup on a non-localhost host must hold a session.
# API_COOKIE_SECURE=true

# How long a quick preview lives unless published.
# API_QUICK_PREVIEW_TTL=24h
# API_CHALLENGE_SCORES_TTL=10s       # how long a challenge board is reused; 0 turns it off

# Host directory of the API's durable files (preview images), bind-mounted
# into expo-api. Relative paths resolve against docker-compose.yaml's
# directory; on a server use an absolute path, e.g. /srv/factorio-expo/storage.
# Back it up together with PostgreSQL.
# EXPO_STORAGE_DIR=./data/storage

# Host directory of the deleted-accounts ledger (ids of hard-deleted accounts,
# replayed after a restore: docs/admin.md#account-deletion). Back it up with
# the dump; never restore an older copy over a newer one.
# EXPO_LEDGER_DIR=./data/ledger

# How many previews may encode at once; 0 means half the CPUs.
# API_PREVIEW_ENCODERS=0

# Storage budget: above 90% of the max, or below the free minimum on the
# storage disk, the API evicts the oldest full-size previews until usage is
# under 80%; they are rendered again when someone opens them. Thumbnails stay.
# Sizes like 150GiB; 0 turns a limit off. A dev machine with less free space
# than the minimum evicts every full preview.
# API_STORAGE_MAX_BYTES=150GiB
# API_STORAGE_MIN_FREE_BYTES=20GiB


# =============================================================================
# Runner tuning
# =============================================================================

# How long temporary artifacts are kept. The API deletes a preview PNG as soon
# as it has stored its own copy; this only bounds artifacts nobody collected.
# RUNNER_ARTIFACT_TTL=24h

# Maximum time for one preview capture.
# RUNNER_CAPTURE_TIMEOUT=5m


# =============================================================================
# Web build
# =============================================================================

# The site's public origin, baked into the web image at build time (canonical
# links, sitemap, feeds). Production: https://your-domain.example
# PUBLIC_SITE_URL=http://localhost:3000

# Base path/URL for generated game icon sheets.
# PUBLIC_GAME_ICONS_BASE_URL=/game-icons/

# Cloudflare Turnstile widget site key for the sign-up forms and the anonymous
# upload, quick preview, revision and report forms; set it together with
# API_TURNSTILE_SECRET_KEY above (test key for localhost there). Unset turns
# the widget off.
# PUBLIC_TURNSTILE_SITE_KEY=

# Who runs the site, shown on the terms of use, the privacy policy, the about
# page and /.well-known/security.txt: one JSON object, single-quoted. Every key
# is optional; a missing one shows as an [OWNER: ...] placeholder, an unknown
# key or invalid JSON fails the web build. Rebuild expo-web after a change.
# PUBLIC_LEGAL='{"name":"Jane Doe","email":"contact@example.org","hostingProvider":"Example Hosting GmbH, Berlin, Germany (server in Germany)","emailProvider":"Example Mail AG, Zurich, Switzerland"}'


# =============================================================================
# Staff console (docker-compose.yaml, profile `admin`; docs/admin.md)
# =============================================================================
# Required by expo-api (its staff listener), whether or not the console runs.
# The token expo-admin sends to it (at least 32 characters): openssl rand -hex 32
ADMIN_API_TOKEN=

# Start the console, Dozzle and their socket proxy: COMPOSE_PROFILES=admin
# (or `docker compose --profile admin up -d`).

# Hostnames, production only (empty locally: http://localhost:3200 for the
# console, http://localhost:9080 for Dozzle). Both sit behind one
# identity-aware proxy application.
# ADMIN_HOST=admin.example.org
# ADMIN_LOGS_HOST=admin-logs.example.org

# The public site, for the console's links to reported entries and comments.
# ADMIN_SITE_URL=http://localhost:3000

# Identity-aware proxy: the team domain and the application's AUD tag. Without both, the console refuses every request.
# ADMIN_ACCESS_TEAM_DOMAIN=myteam.example.com
# ADMIN_ACCESS_AUD=

# Local development only: the staff name the console accepts instead of Access.
# Honoured only while the Access settings above are empty and the console is on
# localhost; ignored anywhere else.
# ADMIN_DEV_USER=dev
