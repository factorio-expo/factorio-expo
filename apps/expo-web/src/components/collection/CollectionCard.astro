---
// One collection as a card: up to four cover thumbnails (or a folder when none
// has a preview), name, description, entry count and, on the owner's own
// list, its visibility (badge on the cover) and a delete button (collections-list.ts drives it).
// Shared by the profile's Collections tab and /account/collections.
import { assetUrl } from "@lib/api/public-asset";
import Folder from "@lucide/astro/icons/folder";
import Trash from "@lucide/astro/icons/trash";
import { type Collection } from "@lib/api";
import { formatRichTextSummary } from "@factorio-expo/ui/game/rich-text.ts";
import { markdownToPlainText } from "@utils/plain-text.ts";
import { stripRichText } from "@factorio-expo/ui/game/rich-text.ts";

interface Props {
	collection: Collection;
	href: string;
	/** The owner's own list: shows visibility and the delete button. */
	owner?: boolean;
}
const { collection, href, owner = false } = Astro.props;
const covers = (collection.cover_urls ?? []).map((url) => assetUrl(url));
const plainName = stripRichText(collection.name).trim() || collection.name;
const count = collection.entry_count;
const entries = `${count.toLocaleString("en-US")} ${count === 1 ? "entry" : "entries"}`;
const visibility = collection.visibility === "public" ? "Public" : "Private";
---

<li class="collection-item" data-collection-id={collection.id}>
	<article class="collection-card">
		<div class="cover-frame">
			<a
				class="cover"
				href={href}
				tabindex="-1"
				aria-hidden="true"
				data-covers={covers.length}
			>
				{covers.length > 0 ? (
					covers.map((src) => <img src={src} alt="" loading="lazy" decoding="async" />)
				) : (
					<Folder class="folder" />
				)}
			</a>
			{owner && (
				<span class="visibility" data-visibility={collection.visibility}>
					{visibility}
				</span>
			)}
		</div>
		<div class="body">
			<h2>
				<a href={href}>
					<Folder class="name-icon" aria-hidden="true" />
					<span set:html={formatRichTextSummary(collection.name)} />
				</a>
			</h2>
			{collection.description && (
				<p
					class="description"
					set:html={formatRichTextSummary(markdownToPlainText(collection.description))}
				/>
			)}
			<footer>
				<small>{entries}</small>
				{owner && (
					<small class="visibility" data-visibility={collection.visibility}>
						{visibility}
					</small>
				)}
				{owner && (
					<button
						type="button"
						class="icon-button delete"
						data-delete-collection={collection.id}
						data-name={plainName}
						aria-label={`Delete ${plainName}`}
						data-tooltip="Delete collection"
						data-placement="left"
					>
						<Trash aria-hidden="true" />
					</button>
				)}
			</footer>
		</div>
	</article>
</li>

<style>
	.collection-item {
		margin: 0;
		list-style: none;
	}
	.collection-card {
		display: flex;
		flex-direction: column;
		height: 100%;
		margin: 0;
		padding: 0;
		overflow-wrap: anywhere;
		transition:
			box-shadow 0.2s,
			transform 0.2s;
	}
	.collection-card:hover,
	.collection-card:focus-within {
		box-shadow: 0 0.75rem 1.75rem rgb(0 0 0 / 0.22);
		transform: translateY(-3px);
	}
	@media (prefers-reduced-motion: reduce) {
		.collection-card {
			transition: none;
		}
		.collection-card:hover,
		.collection-card:focus-within {
			transform: none;
		}
	}
	/* Up to four covers as a mosaic, clipped to the card's top corners. */
	.cover {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 2px;
		aspect-ratio: 4 / 3;
		overflow: hidden;
		border-radius: var(--pico-border-radius) var(--pico-border-radius) 0 0;
		background: var(--pico-muted-border-color);
	}
	.cover[data-covers="0"],
	.cover[data-covers="1"] {
		grid-template-columns: 1fr;
	}
	.cover[data-covers="3"] img:first-child {
		grid-row: span 2;
	}
	.cover img {
		width: 100%;
		height: 100%;
		min-height: 0;
		object-fit: cover;
		background: var(--pico-card-background-color);
	}
	.cover :global(.folder) {
		place-self: center;
		width: 3rem;
		height: 3rem;
		color: var(--pico-muted-color);
	}
	.body {
		display: flex;
		flex: 1;
		flex-direction: column;
		padding: 0.75rem;
	}
	h2 {
		margin: 0 0 0.35rem;
		font-size: 1rem;
		line-height: 1.3;
	}
	h2 a {
		display: flex;
		align-items: flex-start;
		gap: 0.4rem;
		text-decoration: none;
	}
	h2 :global(.name-icon) {
		flex: none;
		width: 1.1rem;
		height: 1.1rem;
		margin-top: 0.1rem;
		color: var(--pico-muted-color);
	}
	.description {
		display: -webkit-box;
		margin: 0 0 0.5rem;
		overflow: hidden;
		color: var(--pico-muted-color);
		font-size: 0.875rem;
		-webkit-box-orient: vertical;
		-webkit-line-clamp: 2;
	}
	footer {
		display: flex;
		align-items: center;
		gap: 0.75rem;
		margin: auto 0 0;
		padding: 0;
		border: none;
		background: none;
		color: var(--pico-muted-color);
	}
	.cover-frame {
		position: relative;
	}
	/* Public or private, top right of the preview. */
	.visibility {
		position: absolute;
		top: 0.4rem;
		right: 0.4rem;
		padding: 0.05rem 0.5rem;
		border-radius: 1rem;
		background: rgb(0 0 0 / 0.7);
		color: #fff;
		font-size: 0.7rem;
		font-weight: 600;
		line-height: 1.4;
	}
	.visibility[data-visibility="public"] {
		background: #1f7a3d;
	}
	.delete {
		margin-left: auto;
		--pico-color: var(--pico-muted-color);
	}
</style>
