---
import type { BlueprintTypeFilter } from "@lib/search/query";

interface Props {
	selected: BlueprintTypeFilter;
	/** Matches that are factories and space platforms, counted without this filter; absent without results. */
	counts?: { factories?: number; platforms?: number };
}

const { selected, counts } = Astro.props;
const factories = counts ? (counts.factories ?? 0) : undefined;
const platforms = counts ? (counts.platforms ?? 0) : undefined;
const options: { value: BlueprintTypeFilter; label: string; count?: number }[] = [
	{
		value: "all",
		label: "All",
		count: factories === undefined ? undefined : factories + (platforms ?? 0),
	},
	{ value: "factories", label: "Factories", count: factories },
	{ value: "platforms", label: "Space platforms", count: platforms },
];
---

<fieldset class="blueprint-type">
	<legend>Blueprint type</legend>
	<div class="type-options">
		{options.map((option) => (
			<label>
				<input
					type="radio"
					name="blueprint_type"
					value={option.value}
					checked={selected === option.value}
				/>
				<span>
					{option.label}
					{option.count !== undefined && (
						<small class="count" data-count={option.value}>
							{option.count.toLocaleString("en-US")}
						</small>
					)}
				</span>
			</label>
		))}
	</div>
</fieldset>

<style>
	.blueprint-type {
		margin: 0;
		min-width: 0;
	}
	.blueprint-type legend {
		margin-bottom: 0.5rem;
	}
	.type-options {
		display: flex;
		border: 1px solid var(--pico-form-element-border-color);
		border-radius: var(--pico-border-radius);
		overflow: hidden;
	}
	.type-options label {
		flex: 1;
		position: relative;
		margin: 0;
		cursor: pointer;
	}
	.type-options input {
		position: absolute;
		width: 1px;
		height: 1px;
		opacity: 0;
	}
	.type-options span {
		display: grid;
		place-items: center;
		height: 100%;
		padding: 0.7rem 0.5rem;
		text-align: center;
		font-size: 0.875rem;
	}
	.type-options .count {
		display: block;
		color: var(--pico-muted-color);
		font-size: 0.75rem;
	}
	.type-options input:checked + span .count {
		color: inherit;
	}
	.type-options input:checked + span {
		background: var(--pico-primary-background);
		color: var(--pico-primary-inverse);
	}
	.type-options input:focus-visible + span {
		outline: 2px solid var(--pico-primary);
		outline-offset: -3px;
	}
</style>
