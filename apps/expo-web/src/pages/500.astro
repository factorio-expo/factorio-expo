---
// Shown for any error a page throws, most often the API being down or
// restarting. Never shows the error itself (it may name internals); the
// server log has it.
import Page from "@layouts/Page.astro";
---

<Page title="Something went wrong" noindex>
	<h1>Something went wrong</h1>
	<p>
		The site could not load this page. This is usually short-lived, for example while we restart
		a service; try again in a minute.
	</p>
	<p>
		<a href={Astro.url.pathname}>Try again</a> or <a href="/">go back home</a>
	</p>
</Page>
