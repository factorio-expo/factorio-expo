# Browser-facing API origin (must be reachable from wherever the browser runs).
# "/" calls the API on the page's own origin: for `astro dev` from localhost
# and the LAN, through the dev proxy (docs/frontend.md#local-development);
# then set API_INTERNAL_BASE_URL=http://localhost:8080.
PUBLIC_API_BASE_URL=http://localhost:8080

# Base path for the static Factorio icon sprite assets.
# For CDN hosting, set this to a versioned HTTPS prefix ending with a slash.
PUBLIC_GAME_ICONS_BASE_URL=/game-icons/

# SSR-only: the API's address on the compose network. Falls back to
# PUBLIC_API_BASE_URL when unset (e.g. for `astro dev` outside compose).
API_INTERNAL_BASE_URL=http://expo-api:8080
