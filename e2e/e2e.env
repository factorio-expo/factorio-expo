# Environment for the e2e compose project (see compose.yaml). Throwaway values
# only: the stack is loopback-only and its database lives in tmpfs. Passed with
# --env-file, so the developer's own .env is never read.

# Required by docker-compose.yaml; Factorio never starts in the e2e stack.
FACTORIO_USERNAME=e2e
FACTORIO_TOKEN=e2e
FACTORIO_RCON_PASSWORD=e2e-rcon-password

POSTGRES_USER=factorio_expo
POSTGRES_PASSWORD=e2e-postgres-password
POSTGRES_DB=factorio_expo
API_POSTGRES_PASSWORD=e2e-api-postgres-password
RUNNER_POSTGRES_PASSWORD=e2e-runner-postgres-password

TYPESENSE_API_KEY=e2e-typesense-key
API_JWT_SECRET=e2e-jwt-secret-that-is-at-least-32-bytes-long
API_IP_HASH_SECRET=e2e-ip-hash-secret-that-is-at-least-32-bytes
# expo-api's staff listener needs a token (at least 32 characters); the console never runs here.
ADMIN_API_TOKEN=e2e-admin-token-that-is-at-least-32-bytes-long

# Host ports (loopback). The web image bakes the API URL in at build time.
E2E_WEB_PORT=3100
E2E_API_PORT=8180
E2E_IMPORT_STUB_PORT=8190
